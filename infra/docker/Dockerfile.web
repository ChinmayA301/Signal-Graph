FROM node:20-bookworm
WORKDIR /app

COPY package.json ./
COPY apps/web/package.json ./apps/web/package.json
COPY packages/shared-types/package.json ./packages/shared-types/package.json

RUN npm install --workspaces --include-workspace-root

COPY packages/shared-types ./packages/shared-types
COPY apps/web ./apps/web

ENV NEXT_TELEMETRY_DISABLED=1

# NEXT_PUBLIC_* values are inlined into the client bundle at build time, not
# read at runtime, so the API URL has to be supplied here. Compose leaves it
# unset and the client falls back to http://localhost:8000.
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}

RUN npm run types:build \
    && npm run build -w apps/web

EXPOSE 3000
WORKDIR /app/apps/web
# Hosts assign the port at runtime; 3000 stays the local/Compose default.
CMD ["sh", "-c", "npm run start -- -p ${PORT:-3000} -H 0.0.0.0"]
